    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f4f4f9;
      color: #333;
      line-height: 1.6;
    }
    header {
      background: #4CAF50;
      color: white;
      padding: 40px 20px;
      text-align: center;
    }
    nav {
      background: #333;
      padding: 15px;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    nav a {
      color: white;
      margin: 0 20px;
      text-decoration: none;
      font-weight: bold;
    }
    nav a:hover {
      color: #4CAF50;
    }
    section {
      padding: 60px 20px;
      max-width: 900px;
      margin: auto;
    }
    .card {
      background: white;
      padding: 30px;
      margin: 30px 0;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    footer {
      background: #333;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 40px;
    }
    button {
      background: #4CAF50;
      color: white;
      border: none;
      padding: 12px 25px;
      cursor: pointer;
      border-radius: 5px;
      font-size: 16px;
    }
    button:hover {
      background: #45a049;
    }

    /* Foto Profil */
    .profile-img {
      width: 150px;
      height: 150px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid white;
      margin-bottom: 15px;
    }

    /* Ikon Sosial Media */
    .social-icons {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 15px;
    }
    .social-icons svg {
      cursor: pointer;
      transition: transform 0.3s ease;
    }
    .social-icons svg:hover {
      transform: scale(1.2);
    }

    /* Animasi Scroll */
    .hidden {
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.8s ease-out;
    }
    .show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
